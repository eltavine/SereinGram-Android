    <string name="serein_declutter_settings">设置</string>
    <string name="serein_declutter_hide_premium">隐藏 Premium 分区</string>
    <string name="serein_declutter_hide_help">隐藏帮助分区</string>
    <string name="serein_declutter_settings_note">Premium 分区包括 Telegram Premium、星星、TON、商业版与礼物；帮助分区包括提问、常见问题、功能介绍与隐私政策。</string>
    <string name="serein_declutter_chats">聊天</string>
    <string name="serein_declutter_hide_share">隐藏消息旁的分享按钮</string>
    <string name="serein_declutter_hide_share_note">转发到收藏夹的消息保留此按钮，用于打开消息来源的聊天。</string>
    <string name="serein_history_title">消息记录</string>
    <string name="serein_history_save">保存</string>
    <string name="serein_history_save_deleted">已删除的消息</string>
    <string name="serein_history_save_edits">消息编辑前的版本</string>
    <string name="serein_history_save_in_bots">包括与机器人的聊天</string>
    <string name="serein_history_save_note">副本按账号保存在本设备上 SereinGram 自己的数据库中，与 Telegram 的缓存分开，清理缓存不会删除它们。保存的已删除消息会带着“已删除”标记回到原聊天中。只有本设备加载过的消息才能保存。已删除消息中的照片和文件会留在 Telegram 的缓存中，只要缓存还保留着它们就能显示。</string>
    <string name="serein_history_deleted_mark">已删除</string>
    <string name="serein_history_appearance">外观</string>
    <string name="serein_history_deleted_mark_title">删除标记</string>
    <string name="serein_history_deleted_mark_note">显示在已保存的已删除消息的时间前。留空则使用默认标记；也可以使用表情，例如 🗑。</string>
    <string name="serein_history_deleted_at">删除于 %1$s</string>
    <string name="serein_history_deleted_list">已删除的消息</string>
    <string name="serein_history_deleted_list_empty">此聊天没有保存已删除的消息。</string>
    <string name="serein_history_deleted_list_note">每条消息旁显示其删除时间。点按可在聊天中找到它。</string>
    <string name="serein_history_deleted_clear">清除已删除的消息</string>
    <string name="serein_history_deleted_clear_note">将永久移除 SereinGram 为此聊天保存的已删除消息。下次打开此聊天时，它们会从聊天中消失。</string>
    <string name="serein_history_deleted_clear_confirm">清除</string>
    <string name="serein_history_edit_history">编辑历史</string>
    <string name="serein_history_versions_title">早先的版本</string>
    <string name="serein_history_version_original">发送于 %1$s</string>
    <string name="serein_history_version_edited">编辑于 %1$s</string>
    <string name="serein_history_version_no_text">无文字</string>
    <string name="serein_history_versions_empty">没有保存这条消息的早先版本。</string>
    <string name="serein_links_title">链接</string>
    <string name="serein_links_opening">打开</string>
    <string name="serein_links_confirm_all">打开链接前询问</string>
    <string name="serein_links_confirm_all_note">在浏览器中打开链接前显示完整地址并询问。指向 Telegram 自身的链接仍会直接打开。</string>
    <string name="serein_ghost_title">幽灵模式</string>
    <string name="serein_ghost_active">启用幽灵模式</string>
    <string name="serein_ghost_indicator">在聊天列表标题旁显示幽灵图标</string>
    <string name="serein_ghost_options">幽灵模式选项</string>
    <string name="serein_ghost_note">幽灵模式不会发送你的已读回执、在线状态、输入状态和动态浏览记录。不发送已读回执时，SereinGram 也不会发送频道评论和私密聊天的已读，你浏览的频道帖子也不会计入浏览量。</string>
    <string name="serein_ghost_chat">此聊天中的幽灵模式</string>
    <string name="serein_ghost_chat_note">让此聊天看到幽灵模式对其他人隐藏的内容。</string>
    <string name="serein_ghost_chat_reads">已读回执</string>
    <string name="serein_ghost_chat_typing">输入状态</string>
    <string name="serein_ghost_exception_both">已读回执和输入状态</string>
    <string name="serein_ghost_mark_read">标为已读</string>
    <string name="serein_ghost_exceptions">例外聊天</string>
    <string name="serein_ghost_exceptions_note">幽灵模式对其他人隐藏你的已读回执或输入状态时，这些聊天仍能看到。在聊天菜单中选择例外；在此长按聊天可移除其例外。</string>
    <string name="serein_ghost_exceptions_empty">还没有例外聊天。可在聊天菜单的“此聊天中的幽灵模式”中选择。</string>
    <string name="serein_ghost_quick">快速开关</string>
    <string name="serein_ghost_add_shortcut">将开关添加到主屏幕</string>
    <string name="serein_ghost_quick_note">也可以在快捷设置中切换幽灵模式：在通知栏中编辑快捷开关，添加 SereinGram 的幽灵模式。</string>
    <string name="serein_ghost_on">幽灵模式已开启</string>
    <string name="serein_ghost_off">幽灵模式已关闭</string>
    <string name="serein_ghost_shortcut_unsupported">此主屏幕无法添加快捷方式。</string>
    <string name="serein_message_menu_title">消息菜单</string>
    <string name="serein_message_menu_items">额外选项</string>
    <string name="serein_message_menu_block_sender">屏蔽用户</string>
    <string name="serein_message_menu_block_sender_note">在群组或频道评论中，长按他人发送的消息时提供屏蔽发送者的选项。</string>
    <string name="serein_timestamps_title">消息时间</string>
    <string name="serein_timestamps_show_date">在时间旁显示日期</string>
    <string name="serein_timestamps_show_date_note">今天以前的消息会在时间旁显示月和日，更早年份的消息则显示完整日期。</string>
    <string name="serein_search_title">搜索</string>
    <string name="serein_search_hide_global">隐藏全局搜索结果</string>
    <string name="serein_search_hide_global_note">在聊天列表中搜索时，不再列出你未加入的公开用户、群组和频道；你的聊天、联系人和消息仍可搜索到。下次启动 SereinGram 时生效。</string>
    <string name="serein_input_title">输入框</string>
    <string name="serein_input_plain_paste">以纯文本粘贴</string>
    <string name="serein_input_plain_paste_note">粘贴到消息和说明中的文字会去掉复制时带有的粗体、链接、表格等格式。需要 Android 6.0 或更高版本。</string>
    <string name="serein_notifications_title">通知</string>
    <string name="serein_notifications_content_when_locked">锁定时显示消息内容</string>
    <string name="serein_notifications_content_when_locked_note">SereinGram 被密码锁定时，通知只会提示收到了消息。开启后，通知会像解锁时一样显示发送者和内容。私密聊天仍会隐藏。</string>
    <string name="serein_bookmarks_title">书签</string>
    <string name="serein_bookmarks_all">全部书签</string>
    <string name="serein_bookmarks_note">可在消息菜单中为消息添加书签，以便日后回到这里。有书签的聊天会在其菜单中列出书签。</string>
    <string name="serein_bookmarks_add">添加书签</string>
    <string name="serein_bookmarks_remove">移除书签</string>
