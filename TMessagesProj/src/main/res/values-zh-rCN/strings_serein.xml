    <string name="serein_message_menu_reply_privately">私聊回复</string>
    <string name="serein_message_menu_items_note">两项都出现在群组或频道评论中他人所发消息的菜单里。「私聊回复」会打开你与对方的私聊，并在那里回复这条消息；群组限制保存内容时不提供此项。</string>
    <string name="serein_timestamps_title">消息时间</string>
    <string name="serein_timestamps_show_date">在时间旁显示日期</string>
    <string name="serein_timestamps_show_date_note">今天以前的消息会在时间旁显示月和日，更早年份的消息则显示完整日期。</string>
    <string name="serein_search_title">搜索</string>
    <string name="serein_search_hide_global">隐藏全局搜索结果</string>
    <string name="serein_search_hide_global_note">在聊天列表中搜索时，不再列出你未加入的公开用户、群组和频道；你的聊天、联系人和消息仍可搜索到。下次启动 SereinGram 时生效。</string>
    <string name="serein_input_title">输入框</string>
    <string name="serein_input_plain_paste">以纯文本粘贴</string>
    <string name="serein_input_plain_paste_note">粘贴到消息和说明中的文字会去掉复制时带有的粗体、链接、表格等格式。需要 Android 6.0 或更高版本。</string>
    <string name="serein_notifications_title">通知</string>
    <string name="serein_notifications_content_when_locked">锁定时显示消息内容</string>
    <string name="serein_notifications_content_when_locked_note">SereinGram 被密码锁定时，通知只会提示收到了消息。开启后，通知会像解锁时一样显示发送者和内容。私密聊天仍会隐藏。</string>
    <string name="serein_notifications_plain_answers">回复时不引用</string>
    <string name="serein_notifications_plain_answers_note">在通知中输入的回复会引用该聊天的最新消息。开启后改为发送普通消息；在话题中仍会发到该话题。</string>
    <string name="serein_bookmarks_title">书签</string>
    <string name="serein_bookmarks_all">全部书签</string>
    <string name="serein_bookmarks_note">可在消息菜单中为消息添加书签，以便日后回到这里。有书签的聊天会在其菜单中列出书签。</string>
    <string name="serein_bookmarks_add">添加书签</string>
    <string name="serein_bookmarks_remove">移除书签</string>
