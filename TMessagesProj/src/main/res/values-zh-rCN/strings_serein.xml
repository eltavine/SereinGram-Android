    <string name="serein_settings_about_note">SereinGram 是基于 Nagram 的非官方 Telegram 客户端，与 Telegram、Nagram、NagramX、NagramXF 及 AyuGram 均无关联。</string>
    <string name="serein_settings_features">功能</string>
