<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="AppIconGreen">綠色</string>
    <string name="serein_settings_entry_info">SereinGram 功能與專案連結</string>
    <string name="serein_settings_about">關於</string>
    <string name="serein_settings_version">版本</string>
    <string name="serein_settings_source">原始碼</string>
    <string name="serein_settings_chat">SereinGram 交流群</string>
    <string name="serein_settings_about_note">SereinGram 是基於 Nagram 的非官方 Telegram 用戶端，與 Telegram、Nagram、NagramX、NagramXF 及 AyuGram 皆無關聯。</string>
    <string name="serein_settings_features">功能</string>
    <string name="serein_declutter_title">隱藏介面元素</string>
    <string name="serein_declutter_settings">設定</string>
    <string name="serein_declutter_hide_premium">隱藏 Premium 區塊</string>
    <string name="serein_declutter_hide_help">隱藏說明區塊</string>
    <string name="serein_declutter_settings_note">Premium 區塊包括 Telegram Premium、星星、TON、商業版與禮物；說明區塊包括提問、常見問題、功能介紹與隱私政策。</string>
    <string name="serein_declutter_chats">聊天</string>
    <string name="serein_declutter_hide_share">隱藏訊息旁的分享按鈕</string>
    <string name="serein_declutter_hide_share_note">轉傳到儲存的訊息會保留此按鈕，用於開啟訊息來源的聊天。</string>
    <string name="serein_history_title">訊息記錄</string>
    <string name="serein_history_save">保存</string>
    <string name="serein_history_save_deleted">已刪除的訊息</string>
    <string name="serein_history_save_edits">訊息編輯前的版本</string>
    <string name="serein_history_save_in_bots">包括與機器人的聊天</string>
    <string name="serein_history_save_note">副本按帳號保存在本裝置上 SereinGram 自己的資料庫中，與 Telegram 的快取分開，清除快取不會刪除它們。保存的已刪除訊息會帶著「已刪除」標記回到原聊天中。只有本裝置載入過的訊息才能保存。已刪除訊息中的相片和檔案會留在 Telegram 的快取中，只要快取還保留著它們就能顯示。</string>
    <string name="serein_history_media">已刪除訊息的媒體</string>
    <string name="serein_history_backup_media">保存媒體副本</string>
    <string name="serein_history_backup_private">私人聊天中</string>
    <string name="serein_history_backup_groups">群組中</string>
    <string name="serein_history_backup_channels">頻道中</string>
    <string name="serein_history_backup_note">已刪除訊息中不超過 64 MB 的相片和檔案會複製到 SereinGram 自己的儲存空間中，清除 Telegram 快取後仍能顯示。只有本裝置下載過的媒體才能複製。</string>
    <string name="serein_history_deleted_mark">已刪除</string>
    <string name="serein_history_appearance">外觀</string>
    <string name="serein_history_deleted_mark_title">刪除標記</string>
    <string name="serein_history_deleted_mark_note">顯示在已保存的已刪除訊息的時間前。留空則使用預設標記；也可以使用表情符號，例如 🗑。</string>
    <string name="serein_history_deleted_at">刪除於 %1$s</string>
    <string name="serein_history_deleted_list">已刪除的訊息</string>
    <string name="serein_history_deleted_list_empty">此聊天沒有保存已刪除的訊息。</string>
    <string name="serein_history_deleted_list_note">每則訊息旁顯示其刪除時間。輕觸可在聊天中找到它。</string>
    <string name="serein_history_deleted_clear">清除已刪除的訊息</string>
    <string name="serein_history_deleted_clear_note">將永久移除 SereinGram 為此聊天保存的已刪除訊息。下次開啟此聊天時，它們會從聊天中消失。</string>
    <string name="serein_history_deleted_clear_confirm">清除</string>
    <string name="serein_history_deleted_export">匯出為文字</string>
    <string name="serein_history_deleted_export_title">%1$s：SereinGram 保存的已刪除訊息</string>
    <string name="serein_history_edit_history">編輯紀錄</string>
    <string name="serein_history_versions_title">先前的版本</string>
    <string name="serein_history_version_original">傳送於 %1$s</string>
    <string name="serein_history_version_edited">編輯於 %1$s</string>
    <string name="serein_history_version_no_text">無文字</string>
    <string name="serein_history_versions_empty">沒有保存這則訊息的先前版本。</string>
    <string name="serein_links_title">連結</string>
    <string name="serein_links_opening">開啟</string>
    <string name="serein_links_confirm_all">開啟連結前詢問</string>
    <string name="serein_links_confirm_all_note">在瀏覽器中開啟連結前顯示完整網址並詢問。指向 Telegram 本身的連結仍會直接開啟。</string>
    <string name="serein_ghost_title">幽靈模式</string>
    <string name="serein_ghost_active">啟用幽靈模式</string>
    <string name="serein_ghost_indicator">在聊天列表標題旁顯示幽靈圖示</string>
    <string name="serein_ghost_options">幽靈模式選項</string>
    <string name="serein_ghost_note">幽靈模式不會傳送你的已讀回條、上線狀態、輸入狀態和限時動態瀏覽記錄。不傳送已讀回條時，SereinGram 也不會傳送頻道留言和私密聊天的已讀，你瀏覽的頻道貼文也不會計入瀏覽次數。</string>
    <string name="serein_ghost_chat">此聊天中的幽靈模式</string>
    <string name="serein_ghost_chat_note">讓此聊天看到幽靈模式對其他人隱藏的內容。</string>
    <string name="serein_ghost_chat_reads">已讀回條</string>
    <string name="serein_ghost_chat_typing">輸入狀態</string>
    <string name="serein_ghost_exception_both">已讀回條和輸入狀態</string>
    <string name="serein_ghost_mark_read">標為已讀</string>
    <string name="serein_ghost_exceptions">例外聊天</string>
    <string name="serein_ghost_exceptions_note">幽靈模式對其他人隱藏你的已讀回條或輸入狀態時，這些聊天仍能看到。在聊天選單中選擇例外；在此長按聊天可移除其例外。</string>
    <string name="serein_ghost_exceptions_empty">還沒有例外聊天。可在聊天選單的「此聊天中的幽靈模式」中選擇。</string>
    <string name="serein_ghost_quick">快速開關</string>
    <string name="serein_ghost_add_shortcut">將開關新增至主畫面</string>
    <string name="serein_ghost_quick_note">也可以在快速設定中切換幽靈模式：在通知欄中編輯快速設定方塊，新增 SereinGram 的幽靈模式。</string>
    <string name="serein_ghost_on">幽靈模式已開啟</string>
    <string name="serein_ghost_off">幽靈模式已關閉</string>
    <string name="serein_ghost_shortcut_unsupported">此主畫面無法新增捷徑。</string>
    <string name="serein_message_menu_title">訊息選單</string>
    <string name="serein_message_menu_items">額外選項</string>
    <string name="serein_message_menu_block_sender">封鎖使用者</string>
    <string name="serein_message_menu_block_sender_note">在群組或頻道留言中，長按他人傳送的訊息時提供封鎖傳送者的選項。</string>
    <string name="serein_timestamps_title">訊息時間</string>
    <string name="serein_timestamps_show_date">在時間旁顯示日期</string>
    <string name="serein_timestamps_show_date_note">今天以前的訊息會在時間旁顯示月和日，更早年份的訊息則顯示完整日期。</string>
    <string name="serein_search_title">搜尋</string>
    <string name="serein_search_hide_global">隱藏全域搜尋結果</string>
    <string name="serein_search_hide_global_note">在聊天列表中搜尋時，不再列出你未加入的公開使用者、群組和頻道；你的聊天、聯絡人和訊息仍可搜尋到。下次啟動 SereinGram 時生效。</string>
    <string name="serein_input_title">輸入框</string>
    <string name="serein_input_plain_paste">以純文字貼上</string>
    <string name="serein_input_plain_paste_note">貼到訊息和說明中的文字會去掉複製時帶有的粗體、連結、表格等格式。需要 Android 6.0 或更新版本。</string>
    <string name="serein_notifications_title">通知</string>
    <string name="serein_notifications_content_when_locked">鎖定時顯示訊息內容</string>
    <string name="serein_notifications_content_when_locked_note">SereinGram 被密碼鎖定時，通知只會提示收到了訊息。開啟後，通知會像解鎖時一樣顯示傳送者和內容。私密聊天仍會隱藏。</string>
    <string name="serein_bookmarks_title">書籤</string>
    <string name="serein_bookmarks_all">所有書籤</string>
    <string name="serein_bookmarks_note">可在訊息選單中為訊息加入書籤，以便日後回到這裡。有書籤的聊天會在其選單中列出書籤。</string>
    <string name="serein_bookmarks_add">加入書籤</string>
    <string name="serein_bookmarks_remove">移除書籤</string>
    <string name="serein_bookmarks_added">已加入書籤</string>
    <string name="serein_bookmarks_removed">已移除書籤</string>
    <string name="serein_bookmarks_view">查看</string>
    <string name="serein_bookmarks_empty">還沒有書籤。可在訊息選單中加入。</string>
    <string name="serein_bookmarks_list_note">輕觸書籤可跳至對應訊息；長按可移除書籤。</string>
    <string name="serein_bookmarks_no_text">無文字訊息</string>
    <string name="serein_local_names_title">本機名稱</string>
    <string name="serein_local_names_all">所有本機名稱</string>
    <string name="serein_local_names_note">可在聊天選單中為使用者、群組和頻道設定只在本裝置上顯示的名稱。</string>
    <string name="serein_local_names_empty">還沒有本機名稱。</string>
    <string name="serein_local_names_list_note">輕觸名稱可開啟聊天；長按可恢復為 Telegram 提供的名稱。</string>
    <string name="serein_local_name">本機名稱</string>
    <string name="serein_local_name_note">只在本裝置上顯示，替代 Telegram 提供的名稱。</string>
    <string name="serein_local_name_remove">移除</string>
    <string name="serein_search_hide_apps">隱藏「應用程式」分頁</string>
    <string name="serein_search_hide_apps_note">在聊天列表中搜尋時不再顯示小程式和機器人分頁。下次啟動 SereinGram 時生效。</string>
    <string name="serein_timestamps_hide_read">已讀訊息也只顯示一個勾</string>
    <string name="serein_timestamps_hide_read_note">你傳送的訊息在被閱讀後仍只顯示一個勾，聊天和聊天列表中都是如此，你不會看到對方何時已讀。Telegram 仍會記錄已讀狀態。</string>
    <string name="serein_ghost_send_scheduled">傳送訊息時不上線</string>
    <string name="serein_ghost_send_scheduled_note">即使在幽靈模式下，傳送訊息也會讓你顯示為上線。開啟後，當幽靈模式隱藏你的上線狀態時，你傳送的訊息會作為排程訊息等待幾秒，送出後再出現在聊天中。私密聊天不受影響。</string>
    <string name="serein_shortcuts_title">聊天捷徑</string>
    <string name="serein_shortcuts_header">在群組或頻道的選單中</string>
    <string name="serein_shortcuts_note">每個捷徑只會在你有權開啟時出現，例如最近動作和權限只對管理員顯示。</string>
</resources>
